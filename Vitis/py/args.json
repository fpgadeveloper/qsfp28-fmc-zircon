{
	"bd_name": "zircon",
	"app_name": "echo_server",
	"app_template": "None",
	"bsp_libs": [
		{
			"name": "lwip220",
			"config": {
				"lwip220_dhcp": "true",
				"lwip220_pbuf_pool_size": "2048",
				"lwip220_n_tx_descriptors": "64",
				"lwip220_n_rx_descriptors": "64",
				"lwip220_tcp_wnd": "32768",
				"lwip220_tcp_snd_buf": "16384"
			}
		},
		{
			"name": "xiltimer"
		}
	],
	"src": {
		"all": "common/src"
	},
	"linker_script_mods": {
		"microblaze": "code_local_bss_ddr"
	},
	"compile_optimization": {
		"microblaze": "-O2"
	},
	"gc_sections": {
		"microblaze": true
	},
	"stack_size": {
		"microblaze": "0x8000",
		"versal": "0x10000"
	},
	"heap_size": {
		"microblaze": "0x10000",
		"versal": "0x10000"
	},
	"pre_platform_build_script": "py/pre_platform_build.py",
	"combine_bit_elf": true
}
